@model NextOnServices.VT.Infrastructure.ViewModels.Project.LucidMarketplaceViewModel
@{
    ViewData["Title"] = "Lucid Marketplace Opportunity Details";
    Layout = "~/Areas/VT/Views/Shared/_Layout.cshtml";
    var opportunity = Model.Opportunity;
    var entryLink = Model.EntryLink;
    var hasMappedProject = opportunity.IsMapped && opportunity.InternalProjectId.HasValue && opportunity.InternalProjectMappingId.HasValue;
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link href="~/css/custmahte.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/VT/vt-project-page.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/VT/vt-dashboard-ref.css" rel="stylesheet" asp-append-version="true" />

<style>
    .vt-lm-opportunity-details {
        --vt-lm-theme: #125b50;
        --vt-lm-border: rgba(18, 91, 80, 0.2);
    }

    .vt-lm-opportunity-details .card--table-section {
        border: 1px solid var(--vt-lm-border);
        box-shadow: 0 8px 22px rgba(18, 91, 80, 0.08);
    }

    .vt-lm-opportunity-details .table-section-header {
        border-left-color: var(--vt-lm-theme);
    }

    .vt-lm-kv {
        margin-bottom: 1rem;
    }

    .vt-lm-kv .label {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 0.2rem;
    }

    .vt-lm-kv .value {
        font-size: 0.95rem;
        color: #0f172a;
        word-break: break-word;
    }

    .vt-lm-json {
        white-space: pre-wrap;
        word-break: break-word;
        max-height: 420px;
        overflow-y: auto;
        background: #f8fafc;
        border: 1px solid #dbe3ea;
        border-radius: 8px;
        padding: 0.85rem;
    }

    .vt-lm-options-preview {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        max-width: 280px;
        max-height: 2.8em;
        text-overflow: ellipsis;
        word-break: break-word;
    }

    #lucidQualificationsFormattedModal .modal-body {
        max-height: calc(100vh - 180px);
        overflow-y: auto;
    }

    .vt-lm-qual-block {
        border: 1px solid var(--vt-lm-border);
        border-radius: 10px;
        padding: 0.9rem 1rem;
        margin-bottom: 0.85rem;
        background: #f8fafc;
    }

    .vt-lm-qual-block h6 {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.25rem;
    }

    .vt-lm-qual-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
        max-height: 220px;
        overflow-y: auto;
    }

    .vt-lm-qual-chips li {
        background: #fff;
        border: 1px solid #dbe3ea;
        border-radius: 999px;
        padding: 0.15rem 0.55rem;
        font-size: 0.78rem;
        color: #334155;
    }
</style>

<div class="vt-project-page vt-dashboard-ref ref-content-wrap vt-lm-opportunity-details">
    <div class="ref-page-title">
        <h1>Lucid Marketplace Opportunity Details</h1>
        <p class="ref-subtitle">Survey ID @opportunity.SurveyId with stored qualifications, quotas, callback payload, and recent sync activity.</p>
    </div>

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card card--table-section">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <h4 class="table-section-header mb-3 mb-md-0">Basic Information</h4>
                        <div>
                            <a class="btn btn-outline-secondary btn-sm mr-2" href="/VT/LucidMarketplace/Opportunities">Back to Opportunities</a>
                            <a class="btn btn-outline-dark btn-sm" href="/VT/LucidMarketplace/Outcomes">Open Outcomes</a>
                            <a class="btn btn-outline-primary btn-sm ml-2" href="/VT/LucidMarketplace/Reconciliation?surveyId=@opportunity.SurveyId@(opportunity.InternalProjectId.HasValue ? $"&internalProjectId={opportunity.InternalProjectId.Value}" : string.Empty)">Open Reconciliation</a>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-3 vt-lm-kv"><div class="label">Survey ID</div><div class="value">@opportunity.SurveyId</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Survey Name</div><div class="value">@opportunity.SurveyName</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Country-Language</div><div class="value">@opportunity.CountryLanguageCode</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Study Type</div><div class="value">@opportunity.StudyType</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Industry</div><div class="value">@opportunity.Industry</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">CPI</div><div class="value">@(opportunity.RevenuePerInterview?.ToString("0.##") ?? "-")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">IR</div><div class="value">@(opportunity.BidIncidence?.ToString("0.##") ?? "-")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">LOI</div><div class="value">@(opportunity.BidLengthOfInterview?.ToString("0.##") ?? "-")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Total Remaining</div><div class="value">@(opportunity.TotalRemaining?.ToString() ?? "-")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Is Live</div><div class="value">@((opportunity.IsLive ?? false) ? "Yes" : "No")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Message Reason</div><div class="value">@opportunity.MessageReason</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Local State</div><div class="value">@opportunity.LocalState</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Last Synced</div><div class="value">@opportunity.LastSyncedOn?.ToString("dd MMM yyyy hh:mm tt")</div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 grid-margin stretch-card">
            <div class="card card--table-section">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <h4 class="table-section-header mb-3 mb-md-0">Entry Link & Launch</h4>
                        <div>
                            @if (hasMappedProject)
                            {
                                <button type="button" class="btn btn-primary btn-sm mr-2" onclick="generateEntryLink(@opportunity.LucidMarketplaceOpportunityId, 'Live')">Generate Live Link</button>
                                <button type="button" class="btn btn-outline-primary btn-sm mr-2" onclick="generateEntryLink(@opportunity.LucidMarketplaceOpportunityId, 'Test')">Generate Test Link</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm mr-2" data-toggle="collapse" data-target="#lucidReturnLinksCollapse" aria-expanded="false" aria-controls="lucidReturnLinksCollapse">View return links</button>
                                <button type="button" class="btn btn-outline-success btn-sm" onclick="updateReturnLinks(@opportunity.LucidMarketplaceOpportunityId)">Update return links on Cint</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary btn-sm" disabled>Map Project First</button>
                            }
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-3 vt-lm-kv"><div class="label">Mapped Project</div><div class="value">@(opportunity.InternalProjectId?.ToString() ?? "-")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Project URL Id</div><div class="value">@(opportunity.InternalProjectUrlId?.ToString() ?? "-")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Project Mapping Id</div><div class="value">@(opportunity.InternalProjectMappingId?.ToString() ?? "-")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Link Record</div><div class="value">@(entryLink.Id > 0 ? $"Saved #{entryLink.Id}" : "Not generated yet")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Supplier Link Type</div><div class="value">@(!string.IsNullOrWhiteSpace(entryLink.SupplierLinkTypeCode) ? entryLink.SupplierLinkTypeCode : "-")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Tracking Type</div><div class="value">@(!string.IsNullOrWhiteSpace(entryLink.TrackingTypeCode) ? entryLink.TrackingTypeCode : "-")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Live Link</div><div class="value">@(!string.IsNullOrWhiteSpace(entryLink.LiveLink) ? "Available" : "Not available")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Test Link</div><div class="value">@(!string.IsNullOrWhiteSpace(entryLink.TestLink) ? "Available" : "Not available")</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">RPI</div><div class="value">@(entryLink.RPIValue?.ToString("0.####") ?? "-") @entryLink.RPICurrencyCode</div></div>
                        <div class="col-md-3 vt-lm-kv"><div class="label">Last Updated</div><div class="value">@entryLink.ModifiedDate?.ToString("dd MMM yyyy hh:mm tt")</div></div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="label mb-2">Live Link Snapshot</div>
                            <div class="vt-lm-json" style="max-height:140px;">@(!string.IsNullOrWhiteSpace(entryLink.LiveLink) ? entryLink.LiveLink : "No live supplier link is stored yet.")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="label mb-2">Test Link Snapshot</div>
                            <div class="vt-lm-json" style="max-height:140px;">@(!string.IsNullOrWhiteSpace(entryLink.TestLink) ? entryLink.TestLink : "No test supplier link is stored yet.")</div>
                        </div>
                    </div>

                    <div class="collapse mt-3" id="lucidReturnLinksCollapse">
                        <div class="label mb-2">Return links (registered with Cint)</div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="label mb-1">Success</div>
                                <div class="vt-lm-json" style="max-height:100px;">@(!string.IsNullOrWhiteSpace(entryLink.SuccessLink) ? entryLink.SuccessLink : "Not registered yet")</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="label mb-1">Failure</div>
                                <div class="vt-lm-json" style="max-height:100px;">@(!string.IsNullOrWhiteSpace(entryLink.FailureLink) ? entryLink.FailureLink : "Not registered yet")</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="label mb-1">Over Quota</div>
                                <div class="vt-lm-json" style="max-height:100px;">@(!string.IsNullOrWhiteSpace(entryLink.OverQuotaLink) ? entryLink.OverQuotaLink : "Not registered yet")</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="label mb-1">Quality Termination</div>
                                <div class="vt-lm-json" style="max-height:100px;">@(!string.IsNullOrWhiteSpace(entryLink.QualityTerminationLink) ? entryLink.QualityTerminationLink : "Not registered yet")</div>
                            </div>
                            <div class="col-md-12 mb-2">
                                <div class="label mb-1">Default</div>
                                <div class="vt-lm-json" style="max-height:100px;">@(!string.IsNullOrWhiteSpace(entryLink.DefaultLink) ? entryLink.DefaultLink : "Not registered yet")</div>
                            </div>
                        </div>
                        <small class="text-muted">These are ProjectStatus return URLs sent to Lucid on Supplier Link Create/Update (<code>ID=[%PID%]</code>). Use Update return links on Cint to push them again.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 grid-margin stretch-card">
            <div class="card card--table-section">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <h4 class="table-section-header mb-3 mb-md-0">Qualifications <small class="text-muted" style="font-size:0.72rem; font-weight:600;">Live from Lucid (not stored)</small></h4>
                        <div>
                            <button type="button" class="btn btn-outline-primary btn-sm mr-2" onclick="loadLiveQualifications(@opportunity.LucidMarketplaceOpportunityId)">Refresh from Lucid</button>
                            <button type="button" class="btn btn-outline-success btn-sm" id="viewFormattedQualificationsBtn" disabled onclick="viewFormattedQualifications(@opportunity.LucidMarketplaceOpportunityId)">View in Formatted</button>
                        </div>
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Question ID</th>
                                    <th>Question</th>
                                    <th>Operator</th>
                                    <th>Options</th>
                                </tr>
                            </thead>
                            <tbody id="lucidLiveQualificationsBody">
                                <tr><td colspan="4" class="text-center text-muted py-3">Loading qualifications from Lucid...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 grid-margin stretch-card">
            <div class="card card--table-section">
                <div class="card-body">
                    <h4 class="table-section-header">Quotas</h4>
                    <div class="table-responsive mt-3">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Quota ID</th>
                                    <th>Quota Type</th>
                                    <th>Conversion</th>
                                    <th>Respondents</th>
                                    <th>Questions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OpportunityQuotas.Any())
                                {
                                    foreach (var item in Model.OpportunityQuotas)
                                    {
                                        <tr>
                                            <td>@item.SurveyQuotaId</td>
                                            <td>@item.SurveyQuotaType</td>
                                            <td>@(item.Conversion?.ToString("0.####") ?? "-")</td>
                                            <td>@(item.NumberOfRespondents?.ToString() ?? "-")</td>
                                            <td><div class="vt-lm-json" style="max-height:120px;">@(!string.IsNullOrWhiteSpace(item.QuestionsJson) ? item.QuestionsJson : item.RawJson)</div></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-3">No quotas were stored for this opportunity.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 grid-margin stretch-card">
            <div class="card card--table-section">
                <div class="card-body">
                    <h4 class="table-section-header">Recent Sync Logs</h4>
                    <div class="table-responsive mt-3">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Status</th>
                                    <th>Started On</th>
                                    <th>Error</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OpportunityLogs.Any())
                                {
                                    foreach (var item in Model.OpportunityLogs)
                                    {
                                        <tr>
                                            <td>@item.ActionName</td>
                                            <td>@(item.IsSuccess ? "Success" : "Failed")</td>
                                            <td>@item.StartedOn?.ToString("dd MMM yyyy hh:mm tt")</td>
                                            <td>@item.ErrorText</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-3">No related sync logs are available yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 grid-margin stretch-card">
            <div class="card card--table-section">
                <div class="card-body">
                    <h4 class="table-section-header">Recent Respondent Attempts</h4>
                    <div class="table-responsive mt-3">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Attempted On</th>
                                    <th>Attempt Type</th>
                                    <th>Respondent</th>
                                    <th>Session / MID</th>
                                    <th>Redirect Return</th>
                                    <th>Final Status</th>
                                    <th>Final Source</th>
                                    <th>Marketplace / Client</th>
                                    <th>Flags</th>
                                    <th>Launch URL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RespondentAttempts.Any())
                                {
                                    foreach (var item in Model.RespondentAttempts)
                                    {
                                        var flagText = item.IsCompleted
                                            ? "Complete"
                                            : item.IsOverQuota
                                                ? "OverQuota"
                                                : item.IsQualityTermination
                                                    ? "Quality"
                                                    : item.IsTerminated
                                                        ? "Terminate"
                                                        : "Open";
                                        <tr>
                                            <td>@item.AttemptedOn?.ToString("dd MMM yyyy hh:mm tt")</td>
                                            <td>@item.AttemptType</td>
                                            <td>@item.RespondentId</td>
                                            <td>@item.SessionId</td>
                                            <td>@item.ReturnStatus @item.ReturnCode</td>
                                            <td>@item.FinalStatus</td>
                                            <td>@item.FinalStatusSource</td>
                                            <td>@item.MarketplaceStatus / @item.ClientStatus</td>
                                            <td>@flagText</td>
                                            <td><div class="vt-lm-json" style="max-height:100px;">@item.LaunchUrl</div></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="9" class="text-center text-muted py-3">No Lucid Marketplace respondent launches have been recorded yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="lucidQualificationsFormattedModal" tabindex="-1" role="dialog" aria-labelledby="lucidQualificationsFormattedTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="lucidQualificationsFormattedTitle">Qualifications — Survey @opportunity.SurveyId</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body" id="lucidQualificationsFormattedBody">
                <p class="text-muted mb-0">Load qualifications from Lucid first.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function generateEntryLink(opportunityId, attemptType) {
            $.ajax({
                type: "POST",
                url: "/VT/LucidMarketplaceApi/GenerateEntryLinkFromOpportunity",
                contentType: "application/json",
                data: JSON.stringify({
                    lucidMarketplaceOpportunityId: opportunityId,
                    attemptType: attemptType,
                    forceRefresh: true
                }),
                success: function (response) {
                    if (response.result) {
                        Swal.fire("Success", response.message || "Lucid Marketplace entry link generated.", "success")
                            .then(function () { window.location.reload(); });
                        return;
                    }

                    Swal.fire("Error", response.message || "Unable to generate the Lucid Marketplace entry link.", "error");
                },
                error: function (xhr) {
                    Swal.fire("Error", xhr.responseJSON?.message || xhr.responseText || "Unable to generate the Lucid Marketplace entry link.", "error");
                }
            });
        }

        function updateReturnLinks(opportunityId) {
            $.ajax({
                type: "POST",
                url: "/VT/LucidMarketplaceApi/UpdateSupplierReturnLinksFromOpportunity",
                contentType: "application/json",
                data: JSON.stringify({
                    lucidMarketplaceOpportunityId: opportunityId
                }),
                success: function (response) {
                    if (response.result) {
                        Swal.fire("Success", response.message || "Return links updated on Cint.", "success")
                            .then(function () { window.location.reload(); });
                        return;
                    }

                    Swal.fire("Error", response.message || "Unable to update return links on Cint.", "error");
                },
                error: function (xhr) {
                    Swal.fire("Error", xhr.responseJSON?.message || xhr.responseText || "Unable to update return links on Cint.", "error");
                }
            });
        }

        function escapeHtml(value) {
            return $("<div/>").text(value == null ? "" : String(value)).html();
        }

        window.lucidLiveQualifications = [];

        function setFormattedQualificationsEnabled(enabled) {
            $("#viewFormattedQualificationsBtn").prop("disabled", !enabled);
        }

        function splitQualificationOptions(item) {
            var labeled = (item && item.options ? String(item.options) : "").trim();
            if (labeled && labeled.indexOf(" - ") >= 0) {
                return labeled.split(/, (?=\S+ - )/);
            }

            var raw = labeled || (item && item.precodes ? String(item.precodes) : "").trim();
            if (!raw) {
                return [];
            }

            return raw.split(/,\s*/).filter(function (part) { return part.length > 0; });
        }

        function renderFormattedQualifications(items) {
            if (!items || items.length === 0) {
                return '<p class="text-muted mb-0">No qualifications to display.</p>';
            }

            return items.map(function (item) {
                var title = item.questionText || ("Question " + (item.questionId || ""));
                var options = splitQualificationOptions(item);
                var chips = options.length
                    ? '<ul class="vt-lm-qual-chips">' + options.map(function (option) {
                        return "<li>" + escapeHtml(option) + "</li>";
                    }).join("") + "</ul>"
                    : '<p class="text-muted mb-0">No options returned.</p>';

                return '<div class="vt-lm-qual-block">' +
                    "<h6>" + escapeHtml(title) + "</h6>" +
                    '<div class="text-muted mb-2" style="font-size:0.78rem;">Question ID ' + escapeHtml(item.questionId || "-") +
                    " · Operator " + escapeHtml(item.logicalOperator || "-") + "</div>" +
                    chips +
                    "</div>";
            }).join("");
        }

        function openFormattedQualificationsModal() {
            $("#lucidQualificationsFormattedBody").html(renderFormattedQualifications(window.lucidLiveQualifications));
            $("#lucidQualificationsFormattedModal").modal("show");
        }

        function viewFormattedQualifications(opportunityId) {
            if (window.lucidLiveQualifications && window.lucidLiveQualifications.length > 0) {
                openFormattedQualificationsModal();
                return;
            }

            loadLiveQualifications(opportunityId, function () {
                if (window.lucidLiveQualifications && window.lucidLiveQualifications.length > 0) {
                    openFormattedQualificationsModal();
                    return;
                }

                Swal.fire("Info", "No live qualifications are available to format.", "info");
            });
        }

        function loadLiveQualifications(opportunityId, onComplete) {
            var $body = $("#lucidLiveQualificationsBody");
            window.lucidLiveQualifications = [];
            setFormattedQualificationsEnabled(false);
            $body.html('<tr><td colspan="4" class="text-center text-muted py-3">Loading qualifications from Lucid...</td></tr>');

            $.ajax({
                type: "GET",
                url: "/VT/LucidMarketplaceApi/FetchLiveQualifications/" + opportunityId,
                success: function (response) {
                    if (!response || !response.result) {
                        $body.html('<tr><td colspan="4" class="text-center text-muted py-3">' + escapeHtml(response?.message || "Unable to load from Lucid.") + '</td></tr>');
                        if (typeof onComplete === "function") {
                            onComplete();
                        }
                        return;
                    }

                    var items = response.items || [];
                    window.lucidLiveQualifications = items;
                    if (items.length === 0) {
                        $body.html('<tr><td colspan="4" class="text-center text-muted py-3">' + escapeHtml(response.message || "No qualifications returned.") + '</td></tr>');
                        if (typeof onComplete === "function") {
                            onComplete();
                        }
                        return;
                    }

                    var html = "";
                    items.forEach(function (item) {
                        html += "<tr>" +
                            "<td>" + escapeHtml(item.questionId || "-") + "</td>" +
                            "<td>" + escapeHtml(item.questionText || "-") + "</td>" +
                            "<td>" + escapeHtml(item.logicalOperator || "-") + "</td>" +
                            '<td><div class="vt-lm-options-preview">' + escapeHtml(item.options || item.precodes || "-") + "</div></td>" +
                            "</tr>";
                    });
                    $body.html(html);
                    setFormattedQualificationsEnabled(true);
                    if (typeof onComplete === "function") {
                        onComplete();
                    }
                },
                error: function (xhr) {
                    $body.html('<tr><td colspan="4" class="text-center text-muted py-3">' + escapeHtml(xhr.responseJSON?.message || xhr.responseText || "Unable to load from Lucid.") + '</td></tr>');
                    if (typeof onComplete === "function") {
                        onComplete();
                    }
                }
            });
        }

        $(function () {
            loadLiveQualifications(@opportunity.LucidMarketplaceOpportunityId);
        });
    </script>
}
