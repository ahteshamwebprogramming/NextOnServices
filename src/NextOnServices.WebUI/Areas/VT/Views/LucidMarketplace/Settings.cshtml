@model NextOnServices.VT.Infrastructure.ViewModels.Project.LucidMarketplaceViewModel
@{
    ViewData["Title"] = "Lucid Marketplace Settings";
    Layout = "~/Areas/VT/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link href="~/css/custmahte.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/VT/vt-project-page.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/VT/vt-dashboard-ref.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/VT/validation.css" rel="stylesheet" asp-append-version="true" />

<style>
    .vt-lm-settings-page {
        --vt-lm-theme: #125b50;
        --vt-lm-theme-dark: #0d4038;
        --vt-lm-soft: rgba(18, 91, 80, 0.08);
        --vt-lm-border: rgba(18, 91, 80, 0.2);
    }

    .vt-lm-settings-page .ref-page-title {
        margin-bottom: 1rem;
    }

    .vt-lm-settings-page .card--table-section {
        border: 1px solid var(--vt-lm-border);
        box-shadow: 0 8px 22px rgba(18, 91, 80, 0.08);
    }

    .vt-lm-settings-page .table-section-header {
        border-left-color: var(--vt-lm-theme);
    }

    .vt-lm-settings-page .vt-form-section {
        margin-bottom: 0.9rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--vt-lm-border);
        border-radius: 8px;
        background: linear-gradient(135deg, #fff 0%, var(--vt-lm-soft) 100%);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--vt-lm-theme-dark);
    }

    .vt-lm-settings-page .form-control,
    .vt-lm-settings-page textarea.form-control {
        border-radius: 8px;
        border: 1px solid #dbe3ea;
    }

    .vt-lm-settings-page .form-control:focus {
        border-color: var(--vt-lm-theme);
        box-shadow: 0 0 0 2px rgba(18, 91, 80, 0.12);
    }

    .vt-lm-settings-page .input-group .btn {
        border-radius: 0 8px 8px 0;
        border: 1px solid #dbe3ea;
        border-left: 0;
        color: var(--vt-lm-theme-dark);
        background: #f8fafc;
    }

    .vt-lm-settings-page .input-group .btn:focus {
        box-shadow: 0 0 0 2px rgba(18, 91, 80, 0.12);
    }

    .vt-lm-settings-page .select2-container {
        width: 100% !important;
    }

    .vt-lm-settings-page .switch-wrap {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        min-height: 38px;
    }

    .vt-lm-settings-page .required::after {
        content: " *";
        color: #dc2626;
    }
</style>

<div class="vt-project-page vt-dashboard-ref ref-content-wrap vt-lm-settings-page">
    <div class="ref-page-title">
        <h1>Lucid Marketplace Settings</h1>
        <p class="ref-subtitle">Store the base configuration for the new Lucid Marketplace module and keep it separate from legacy Lucid Offerwall settings.</p>
    </div>

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card card--table-section">
                <div class="card-body">
                    <h4 class="table-section-header">Configuration</h4>
                    <form id="LucidMarketplaceSettingsForm" class="forms-sample">
                        <div class="vt-form-section">API Settings</div>
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label class="required">Base URL</label>
                                <input asp-for="Setting.BaseUrl" class="form-control form-control-sm requiredInput" />
                            </div>
                            <div class="form-group col-md-4">
                                <label class="required">API Key</label>
                                <div class="input-group input-group-sm">
                                    <input asp-for="Setting.ApiKey" type="password" class="form-control form-control-sm" autocomplete="new-password" />
                                    <div class="input-group-append">
                                        <button type="button"
                                                class="btn btn-light"
                                                id="toggleLucidMarketplaceApiKey"
                                                aria-label="Show password"
                                                aria-pressed="false"
                                                title="Show password">
                                            <span class="mdi mdi-eye" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-1">Leave blank to keep existing API key.</small>
                            </div>
                            <div class="form-group col-md-4">
                                <label>Entry Link Secret Key</label>
                                <div class="input-group input-group-sm">
                                    <input asp-for="Setting.EntryLinkSecretKey" type="password" class="form-control form-control-sm" autocomplete="new-password" />
                                    <div class="input-group-append">
                                        <button type="button"
                                                class="btn btn-light"
                                                id="toggleLucidMarketplaceEntryLinkSecretKey"
                                                aria-label="Show password"
                                                aria-pressed="false"
                                                title="Show password">
                                            <span class="mdi mdi-eye" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-1">Used only for Lucid Marketplace respondent entry-link signing. Leave blank to keep the existing secret.</small>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="required">Supplier Code</label>
                                <input asp-for="Setting.SupplierCode" class="form-control form-control-sm requiredInput" />
                            </div>
                            <div class="form-group col-md-6">
                                <label class="required">Opportunities Callback URL</label>
                                <input asp-for="Setting.OpportunitiesCallbackUrl" class="form-control form-control-sm" />
                                <small class="text-muted d-block mt-1">Required for Opportunities subscription.</small>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="required">Outcomes Callback URL</label>
                                <input asp-for="Setting.OutcomesCallbackUrl" class="form-control form-control-sm" />
                                <small class="text-muted d-block mt-1">Required for Outcomes subscription.</small>
                            </div>
                        </div>

                        <div class="vt-form-section">Behavior</div>
                        <div class="row">
                            <div class="form-group col-md-3">
                                <label>Supplier Link Type</label>
                                <select asp-for="Setting.SupplierLinkTypeCode" class="form-control form-control-sm">
                                    <option value="">-- Default (OWS) --</option>
                                    <option value="OWS">OWS</option>
                                    <option value="TS">TS</option>
                                </select>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Tracking Type</label>
                                <select asp-for="Setting.TrackingTypeCode" class="form-control form-control-sm">
                                    <option value="">-- Default (NONE) --</option>
                                    <option value="NONE">NONE</option>
                                    <option value="PIXEL">PIXEL</option>
                                    <option value="S2S">S2S</option>
                                </select>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Auto Sync Enabled</label>
                                <div class="switch-wrap"><input asp-for="Setting.AutoSyncEnabled" type="checkbox" /><span>Enable scheduled sync foundation</span></div>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Sync Interval Minutes</label>
                                <input asp-for="Setting.SyncIntervalMinutes" class="form-control form-control-sm" type="number" min="1" />
                            </div>
                            <div class="form-group col-md-3">
                                <label>Is Active</label>
                                <div class="switch-wrap"><input asp-for="Setting.IsActive" type="checkbox" /><span>Enable the Lucid Marketplace module</span></div>
                            </div>
                        </div>

                        <div class="vt-form-section">Defaults</div>
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label>Default Client</label>
                                <select asp-for="Setting.DefaultClientId" class="form-control form-control-sm select2">
                                    <option value="">-- Select Client --</option>
                                    @foreach (var client in Model.Clients)
                                    {
                                        <option value="@client.ClientId">@client.Company</option>
                                    }
                                </select>
                                <small class="text-muted d-block mt-2">Assigned automatically when a Lucid Marketplace project is added.</small>
                            </div>
                            <div class="form-group col-md-4">
                                <label>Default Country</label>
                                <select asp-for="Setting.DefaultCountryId" class="form-control form-control-sm select2">
                                    <option value="">-- Select Country --</option>
                                    @foreach (var country in Model.Countries)
                                    {
                                        <option value="@country.CountryId">@country.Country</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group col-md-4">
                                <label>Supplier CPI %</label>
                                <input asp-for="Setting.SupplierCpiPercent" class="form-control form-control-sm" type="number" min="1" max="100" step="0.01" placeholder="100" />
                                <small class="text-muted d-block mt-2">ProjectMapping CPI = Lucid CPI × this %. Leave blank for 100%. Project CPI stays full Lucid CPI.</small>
                            </div>
                            <div class="form-group col-md-12">
                                <label>Default Suppliers</label>
                                <select asp-for="Setting.DefaultSupplierIds" class="form-control form-control-sm select2" multiple>
                                    @foreach (var supplier in Model.Suppliers.Where(x => x.IsActive == 1))
                                    {
                                        <option value="@supplier.Id">@supplier.Name</option>
                                    }
                                </select>
                                <small class="text-muted d-block mt-2">When a Lucid Marketplace project is added, one supplier mapping is created for each selected supplier.</small>
                            </div>
                        </div>

                        <div class="vt-form-section">Project Sampling Hashing</div>
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label>Enable Hashing</label>
                                <div class="switch-wrap">
                                    <input asp-for="Setting.EnableHashing" type="checkbox" id="Setting_EnableHashing" />
                                    <span>When enabled, Add Project stores hashing on Project Mapping and can rewrite LiveLink URL parts.</span>
                                </div>
                            </div>
                            <div class="form-group col-md-4 lucid-hashing-fields">
                                <label>Hash Parameter</label>
                                <select asp-for="Setting.HashingParameter" class="form-control form-control-sm" id="Setting_HashingParameter">
                                    <option value="enc">enc</option>
                                    <option value="hash">hash</option>
                                    <option value="token">token</option>
                                </select>
                                <small class="text-muted d-block mt-2">Same options as Project Mapping Parameter Name (e.g. <code>hash</code> for Lucid).</small>
                            </div>
                            <div class="form-group col-md-4 lucid-hashing-fields">
                                <label>Hashing Type</label>
                                @{
                                    var selectedHashingType = Model?.Setting?.HashingType?.Trim() ?? string.Empty;
                                    var configuredHashTypes = (Model?.HashingSettings ?? new List<NextOnServices.Infrastructure.Models.Settings.HashingSettingDTO>())
                                        .Where(x => x.IsActive && !string.IsNullOrWhiteSpace(x.HashingType))
                                        .Select(x => x.HashingType!.Trim())
                                        .Distinct(StringComparer.OrdinalIgnoreCase)
                                        .ToList();
                                    var hasSelectedHashingType = configuredHashTypes.Any(x => string.Equals(x, selectedHashingType, StringComparison.OrdinalIgnoreCase));
                                }
                                <select asp-for="Setting.HashingType" class="form-control form-control-sm" id="Setting_HashingType">
                                    <option value="">-- Select Hashing Type --</option>
                                    @foreach (var hashingType in configuredHashTypes)
                                    {
                                        <option value="@hashingType">@hashingType</option>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(selectedHashingType) && !hasSelectedHashingType)
                                    {
                                        <option value="@selectedHashingType">@selectedHashingType</option>
                                    }
                                </select>
                                <small class="text-muted d-block mt-2">Uses keys from Settings → Hashing settings (same dropdown as Project Mapping).</small>
                            </div>
                        </div>

                        <div class="vt-form-section">Entry Link Mapping</div>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label>Replace</label>
                                <input asp-for="Setting.RespondentIdUrlParts" class="form-control form-control-sm" placeholder="PID=" />
                                <small class="text-muted d-block mt-2">Find this LiveLink text when Enable Hashing is on (comma-separated for multiple).</small>
                            </div>
                            <div class="form-group col-md-6">
                                <label>With</label>
                                <input asp-for="Setting.RespondentIdUrlReplaceWith" class="form-control form-control-sm" placeholder="PID=[respondentID]" />
                                <small class="text-muted d-block mt-2">Replacement text (e.g. <code>PID=[respondentID]</code>). Defaults to <code>[respondentID]</code> if blank. When hashing is off, LiveLink is stored as-is.</small>
                            </div>
                        </div>

                        <input asp-for="Setting.LucidMarketplaceSettingId" type="hidden" />

                        <div class="mt-3">
                            <button type="button" class="btn btn-primary btn-sm mr-2" onclick="saveLucidMarketplaceSettings()">Save Settings</button>
                            <button type="button" class="btn btn-info btn-sm mr-2" onclick="testLucidMarketplaceConnectivity()">Test Connectivity</button>
                            <a class="btn btn-light btn-sm" href="/VT/LucidMarketplace/Dashboard">Back to Dashboard</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/customJS/Validation.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $(".select2").select2({
                dropdownCssClass: 'vt-theme-dropdown',
                width: '100%'
            });

            $("#toggleLucidMarketplaceApiKey").on("click", function () {
                const $button = $(this);
                const $icon = $button.find(".mdi");
                const $input = $("#Setting_ApiKey");
                const showValue = $input.attr("type") === "password";

                $input.attr("type", showValue ? "text" : "password");
                $button.attr("aria-pressed", showValue ? "true" : "false");
                $button.attr("aria-label", showValue ? "Hide password" : "Show password");
                $button.attr("title", showValue ? "Hide password" : "Show password");
                $icon.toggleClass("mdi-eye", !showValue);
                $icon.toggleClass("mdi-eye-off", showValue);
            });

            $("#toggleLucidMarketplaceEntryLinkSecretKey").on("click", function () {
                const $button = $(this);
                const $icon = $button.find(".mdi");
                const $input = $("#Setting_EntryLinkSecretKey");
                const showValue = $input.attr("type") === "password";

                $input.attr("type", showValue ? "text" : "password");
                $button.attr("aria-pressed", showValue ? "true" : "false");
                $button.attr("aria-label", showValue ? "Hide password" : "Show password");
                $button.attr("title", showValue ? "Hide password" : "Show password");
                $icon.toggleClass("mdi-eye", !showValue);
                $icon.toggleClass("mdi-eye-off", showValue);
            });

            function syncLucidHashingFieldsVisibility() {
                const enabled = $("#Setting_EnableHashing").is(":checked");
                $(".lucid-hashing-fields").toggle(enabled);
            }

            $("#Setting_EnableHashing").on("change", syncLucidHashingFieldsVisibility);
            syncLucidHashingFieldsVisibility();
        });

        function buildSettingsPayload() {
            const $form = $("#LucidMarketplaceSettingsForm");
            const enableHashing = $form.find("[name='Setting.EnableHashing']").is(":checked");
            return {
                lucidMarketplaceSettingId: parseInt($form.find("[name='Setting.LucidMarketplaceSettingId']").val() || "0"),
                baseUrl: $form.find("[name='Setting.BaseUrl']").val(),
                apiKey: $form.find("[name='Setting.ApiKey']").val(),
                entryLinkSecretKey: $form.find("[name='Setting.EntryLinkSecretKey']").val(),
                supplierCode: $form.find("[name='Setting.SupplierCode']").val(),
                opportunitiesCallbackUrl: $form.find("[name='Setting.OpportunitiesCallbackUrl']").val(),
                outcomesCallbackUrl: $form.find("[name='Setting.OutcomesCallbackUrl']").val(),
                supplierLinkTypeCode: $form.find("[name='Setting.SupplierLinkTypeCode']").val(),
                trackingTypeCode: $form.find("[name='Setting.TrackingTypeCode']").val(),
                useConsultingsBridge: false,
                autoSyncEnabled: $form.find("[name='Setting.AutoSyncEnabled']").is(":checked"),
                syncIntervalMinutes: parseInt($form.find("[name='Setting.SyncIntervalMinutes']").val() || "0") || null,
                defaultClientId: parseNullableInt($form.find("[name='Setting.DefaultClientId']").val()),
                defaultCountryId: parseNullableInt($form.find("[name='Setting.DefaultCountryId']").val()),
                defaultSupplierIds: parseIntArray($form.find("[name='Setting.DefaultSupplierIds']").val()),
                supplierCpiPercent: parseNullableDecimal($form.find("[name='Setting.SupplierCpiPercent']").val()),
                enableHashing: enableHashing,
                hashingParameter: enableHashing ? ($form.find("[name='Setting.HashingParameter']").val() || "hash") : null,
                hashingType: enableHashing ? normalizeNullableText($form.find("[name='Setting.HashingType']").val()) : null,
                respondentIdUrlParts: normalizeNullableText($form.find("[name='Setting.RespondentIdUrlParts']").val()),
                respondentIdUrlReplaceWith: normalizeNullableText($form.find("[name='Setting.RespondentIdUrlReplaceWith']").val()),
                isActive: $form.find("[name='Setting.IsActive']").is(":checked")
            };
        }

        function normalizeNullableText(value) {
            const raw = (value || "").trim();
            return raw ? raw : null;
        }

        function parseNullableInt(value) {
            const parsedValue = parseInt(value || "", 10);
            return isNaN(parsedValue) || parsedValue <= 0 ? null : parsedValue;
        }

        function parseNullableDecimal(value) {
            const raw = (value || "").trim();
            if (!raw) {
                return null;
            }
            const parsedValue = Number(raw);
            return isNaN(parsedValue) ? null : parsedValue;
        }

        function parseIntArray(values) {
            if (!values || !values.length) {
                return [];
            }

            const source = Array.isArray(values) ? values : [values];
            return source
                .map(function (item) { return parseInt(item, 10); })
                .filter(function (item) { return !isNaN(item) && item > 0; });
        }

        function saveLucidMarketplaceSettings() {
            if (!isValidateForm("LucidMarketplaceSettingsForm")) {
                return;
            }

            const payload = buildSettingsPayload();
            if (payload.enableHashing && !(payload.hashingType || "").trim()) {
                Swal.fire("Required", "Select a Hashing Type when Enable Hashing is on.", "warning");
                return;
            }
            if (payload.lucidMarketplaceSettingId <= 0 && !(payload.apiKey || "").trim()) {
                Swal.fire("Required", "Enter an API key before saving new Lucid Marketplace settings.", "warning");
                return;
            }

            $.ajax({
                type: "POST",
                url: "/VT/LucidMarketplaceApi/SaveSettings",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function () {
                    Swal.fire({ title: "Success", text: "Lucid Marketplace settings saved successfully.", icon: "success" })
                        .then(function () { window.location.reload(); });
                },
                error: function (xhr) {
                    Swal.fire("Error", xhr.responseText || "Unable to save settings right now.", "error");
                }
            });
        }

        function testLucidMarketplaceConnectivity() {
            const payload = buildSettingsPayload();
            $.ajax({
                type: "POST",
                url: "/VT/LucidMarketplaceApi/TestConnectivity",
                contentType: "application/json",
                data: JSON.stringify({
                    baseUrl: payload.baseUrl,
                    apiKey: payload.apiKey,
                    supplierCode: payload.supplierCode,
                    useConsultingsBridge: payload.useConsultingsBridge
                }),
                success: function (response) {
                    Swal.fire(response.result ? "Connected" : "Not Connected", response.message || "Connectivity test completed.", response.result ? "success" : "info");
                },
                error: function (xhr) {
                    Swal.fire("Error", xhr.responseText || "Connectivity test failed.", "error");
                }
            });
        }
    </script>
}

